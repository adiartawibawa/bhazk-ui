{
    "name": "adiartawibawa/bhazk-ui",
    "description": "Modular UI Component Library with DaisyUI",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "blade",
        "daisyui",
        "alpinejs",
        "livewire",
        "ui-components",
        "component-library"
    ],
    "authors": [
        {
            "name": "Adi Arta Wibawa",
            "email": "surat.buat.adi@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/view": "^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "AdiArtaWibawa\\BhazkUi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AdiArtaWibawa\\BhazkUi\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AdiArtaWibawa\\BhazkUi\\BhazkUiServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
